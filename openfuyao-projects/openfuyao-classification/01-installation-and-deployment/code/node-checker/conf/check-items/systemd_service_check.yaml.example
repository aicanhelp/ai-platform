name: systemd_service_check
kind: kv-checker
doc: 模拟检查systemd服务是否符合系统运行部署所需
spec:
  source:
    command:
      - systemctl list-units -all --plain
  kvParser:
    reGroup: ^(\S+)\s+\S+\s+(\S+)\s+\S+\s+.*$
  subItems:
    - name: ntp-service
      expect: active
      type: regex
      key: |-
        ntp.service
        chronyd.service
      doc: 检查ntp服务是否正常运行
      matchType: last
    - name: sshd.service
      expect: active
      type: str
      key: |-
        sshd.service
        ssh.service
      doc: 检查sshd服务是否正常运行
      matchType: last
    - name: crond.service
      expect: active
      type: str
      key: |-
        crond.service
        cron.service
      doc: 检查crond服务是否正常运行
      matchType: last
