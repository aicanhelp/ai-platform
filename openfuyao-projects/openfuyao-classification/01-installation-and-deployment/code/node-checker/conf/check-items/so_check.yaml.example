name: so-check
kind: command
doc: 模拟检查so库是否符合系统运行部署所需
spec:
  - name: libcrypt.so
    command: ldconfig -p | grep crypt.so | grep -oP "=> \K[^ ]+" | xargs -n 1 realpath -e && echo "Exist" || echo "Not Found"
    expect: Exist
    type: regex
    doc: 检查libcrypt.so是否存在
  - name: libseccomp.so
    command: ldconfig -p | grep libseccomp.so | grep -oP "=> \K[^ ]+" | xargs -n 1 realpath -e && echo "Exist" || echo "Not Found"
    expect: Exist
    type: regex
    doc: 检查libnss_dns.so是否存在
  - name: libpthread.so.0
    command: ldconfig -p | grep libpthread.so.0 | grep -oP "=> \K[^ ]+" | xargs -n 1 realpath -e && echo "Exist" || echo "Not Found"
    expect: Exist
    type: regex
    doc: 检查libpthread.so.0是否存在
