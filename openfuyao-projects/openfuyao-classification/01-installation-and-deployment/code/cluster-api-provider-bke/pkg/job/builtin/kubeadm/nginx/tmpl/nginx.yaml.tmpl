apiVersion: v1
kind: Pod
metadata:
  name: nginx-proxy
  namespace: kube-system
spec:
  containers:
  - image: {{ .Extra.ImageRepo }}{{ .Extra.NginxImageName }}:{{ .Extra.NginxImageTag }}
    imagePullPolicy: IfNotPresent
    name: nginx-proxy
    resources:
      limits:
        cpu: 300m
        memory: 512Mi
      requests:
        cpu: 25m
        memory: 32Mi
    livenessProbe:
      tcpSocket:
        host: 127.0.0.1
        port: {{ .Extra.APIServerPort }}
      initialDelaySeconds: 10
      periodSeconds: 10
    readinessProbe:
      tcpSocket:
        host: 127.0.0.1
        port: {{ .Extra.APIServerPort }}
      initialDelaySeconds: 5
      periodSeconds: 10
    volumeMounts:
    - mountPath: /etc/nginx
      name: etc-nginx
      readOnly: true
  hostNetwork: true
  priorityClassName: system-node-critical
  volumes:
  - hostPath:
      path: {{ .Extra.ManifestsDir }}
      type: DirectoryOrCreate
    name: etc-nginx
