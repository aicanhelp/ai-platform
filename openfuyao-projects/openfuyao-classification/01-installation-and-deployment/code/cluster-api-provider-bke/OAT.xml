<configuration>
    <oatconfig>

        <policylist>
            <policy name="projectPolicy">
                <policyitem type="compatibility" name="MulanPSL-2.0" path=".*" rule="may" defaultGroup="defaultGroup" filefilter="defaultFilter"/>
                <policyitem type="compatibility" name="Apache-2.0" path=".*" rule="may" defaultGroup="defaultGroup" filefilter="defaultFilter"/>
                <policyitem type="compatibility" name="MIT License" path=".*" rule="may" defaultGroup="defaultGroup" filefilter="defaultFilter"/>
                <policyitem type="license" name="MulanPSL-2.0" path=".*" rule="may" defaultGroup="defaultGroup" filefilter="defaultFilter"/>
                <policyitem type="license" name="Apache-2.0" path=".*" rule="may" defaultGroup="defaultGroup" filefilter="defaultFilter"/>
                <policyitem type="license" name="MIT License" path=".*" rule="may" defaultGroup="defaultGroup" filefilter="defaultFilter"/>
                <policyitem type="copyright" name="Bocloud Technologies Co., Ltd." path=".*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter"/>
                <policyitem type="copyright" name="Huawei Technologies Co., Ltd." path=".*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter"/>
                <policyitem type="copyright" name="The Kubernetes Authors" path=".*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter"/>
                <policyitem type="copyright" name="The Helm Authors" path=".*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter"/>
                <policyitem type="copyright" name="ICBC Co., Ltd." path=".*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter"/>
                <policyitem type="copyright" name="bocloud &lt;fushaosong@beyondcent.com&gt;." path=".*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter"/>
                <policyitem type="copyright" name="Vladimir Vivien." path=".*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter"/>
                <policyitem type="copyright" name="btfak." path=".*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter"/>
            </policy>
        </policylist>

        <filefilterlist>
            <filefilter name="defaultFilter" desc="Files not to check">
                <filteritem type="filename" name="go.mod|go.sum"/>
                <filteritem type="filename" name="*.yaml"/>
                <filteritem type="filename" name="LICENSE"/>
                <filteritem type="filename" name="*.dockerignore"/>
            </filefilter>
        </filefilterlist>

        <licensematcherlist>
            <licensematcher name="MulanPSL-2.0" desc="Mulan Permissive Software License, Version 2">
                <licensetext name="is licensed under Mulan PSL v2"/>
            </licensematcher>
            <licensematcher name="MulanPSL-2.0" desc="Mulan Permissive Software License, Version 2">
                <licensetext name="
                    Mulan Permissive Software License，Version 2 (Mulan PSL v2)
                    January 2020 http://license.coscl.org.cn/MulanPSL2
                "/>
            </licensematcher>
            <licensematcher name="MulanPSL-2.0" desc="Mulan Permissive Software License, Version 2">
                <licensetext name="
                    木兰宽松许可证， 第2版
                    2020年1月 http://license.coscl.org.cn/MulanPSL2
                "/>
            </licensematcher>
        </licensematcherlist>

    </oatconfig>
</configuration>