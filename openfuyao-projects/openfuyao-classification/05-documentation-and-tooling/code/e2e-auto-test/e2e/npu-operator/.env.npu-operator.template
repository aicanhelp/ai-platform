# npu-operator 安装部署测试环境变量配置模板
# 复制此文件为 .env.npu-operator 并填写实际值

# ==================== 集群节点配置 ====================
# 使用 npu-operator 组件的节点信息
# 只需填写 IP 和密码，其他配置从模板继承
# 多节点集群复制模板顺序书写即可

# 节点1 - master
TEST_NODE1_IP=192.168.
TEST_NODE1_PASSWORD=
TEST_NODE1_PORT=22
TEST_NODE1_USER=root
TEST_NODE1_NAME=master

# 节点2 - worker
TEST_NODE2_IP=192.168.
TEST_NODE2_PASSWORD=
TEST_NODE2_PORT=22
TEST_NODE2_USER=root
TEST_NODE2_NAME=worker
