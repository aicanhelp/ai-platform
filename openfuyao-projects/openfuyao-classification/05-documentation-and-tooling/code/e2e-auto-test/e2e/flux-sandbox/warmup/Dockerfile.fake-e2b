FROM golang:1.24 AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY flux-sandbox/warmup/fakee2b ./flux-sandbox/warmup/fakee2b
RUN CGO_ENABLED=0 go build -o /fake-e2b ./flux-sandbox/warmup/fakee2b

FROM alpine:3.20
COPY --from=builder /fake-e2b /usr/local/bin/fake-e2b
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/fake-e2b"]
