{
    "compilerOptions": {
        "target": "es2020",
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "@/*": ["./*"],
        },
    },
    "include": [
        "./**/*.ts",
        "./**/*.d.ts",
        "./**/*.js",
    ],
    "exclude": [
        "node_modules",
        "playwright-report",
        "test-results",
    ],
}