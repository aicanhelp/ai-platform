{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "ls-pod",
    "annotations": {
      "openfuyao.com/qos-level": "LS"
    }
  },
  "spec": {
    "containers": [{
      "name": "app",
      "image": "nginx:1.15.1",
      "resources": {
        "requests": { "cpu": "2", "memory": "4Gi" },
        "limits":   { "cpu": "2", "memory": "4Gi" }
      }
    }]
  }
}