{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "be-pod-init",
    "annotations": {
      "openfuyao.com/qos-level": "BE"
    }
  },
  "spec": {
    "initContainers": [{
      "name": "init-app",
      "image": "nginx:1.15.1",
      "resources": {
        "requests": {
          "kubernetes.io/be-cpu": "1000",
          "kubernetes.io/be-memory": "4Gi"
        },
        "limits": {
          "kubernetes.io/be-cpu": "1000",
          "kubernetes.io/be-memory": "8000Mi"
        }
      }
    }],
    "containers": [{
      "name": "app",
      "image": "nginx:1.15.1",
      "resources": {
        "requests": {
          "kubernetes.io/be-cpu": "1000",
          "kubernetes.io/be-memory": "4Gi"
        },
        "limits": {
          "kubernetes.io/be-cpu": "1000",
          "kubernetes.io/be-memory": "8000Mi"
        }
      }
    }]
  }
}