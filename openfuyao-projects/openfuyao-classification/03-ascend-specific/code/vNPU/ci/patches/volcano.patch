+// GetXPUIgnoreStatus check if a xpu resource need to be ignored
+func GetXPUIgnoreStatus(rName string) bool {
+	xpuResource := make(map[string]struct{})
+	xpuResource["huawei.com/vnpu-number"] = struct{}{}
+	if strings.HasPrefix(rName, "huawei.com/") {
+		if _, ok := xpuResource[rName]; !ok {
+			return true
+		}
+	}
+	return false
+}
